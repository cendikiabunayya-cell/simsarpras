# =============================================================================
# SIMSARPRAS: Backend Environment Variables Template
# Versi: 2.1.0 - Render Web Service / Supabase PostgreSQL Staging
# =============================================================================

# Server Port & Mode
PORT=10000
NODE_ENV=development

# Penanda Lingkungan Staging & Guardrail Keselamatan Migrasi (Wajib untuk 'npm run migrate')
APP_ENV=staging
ALLOW_STAGING_MIGRATION=true
# Ganti dengan Project Reference Supabase Staging Anda (contoh: 'abcdefghijklmnopqrst')
STAGING_PROJECT_REF="[PROJECT_REF_STAGING_SUPABASE]"

# Supabase / PostgreSQL Connection Strings
# 1. DIRECT_URL: Port 5432 (Session Mode / Direct) untuk migrasi DDL (npm run migrate)
# DIRECT_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL=""

# 2. DATABASE_URL: Port 6543 (Transaction Mode / PgBouncer) untuk runtime Express API
# DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL=""

# JWT Secret untuk Autentikasi Pengguna (Minimal 32 karakter acak)
JWT_SECRET="ganti_dengan_kunci_rahasia_jwt_minimal_32_karakter_acak"
JWT_EXPIRES_IN="7d"

# CORS Whitelist (Domain frontend yang diizinkan berinteraksi dengan API)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://192.168.100.45:5173,https://simsarpras-staging.pages.dev"

# Rate Limiting untuk Pengajuan Peminjaman Publik
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
